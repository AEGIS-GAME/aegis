{
  "name": "aegis-client",
  "version": "2.9.7",
  "description": "A client for Aegis",
  "main": "dist/main/index.js",
  "author": "CPSC 383",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint src src-electron --fix",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:pack": "npm run build && electron-builder build --publish never",
    "build:pack:win": "npm run build && electron-builder build --win --publish never",
    "build:pack:mac": "npm run build && electron-builder build --mac --publish never",
    "build:pack:linux": "npm run build && electron-builder build --linux --publish never"
  },
  "build": {
    "appId": "com.aegis.app",
    "productName": "AEGIS",
    "compression": "store",
    "directories": {
      "output": "releases/${platform}"
    },
    "files": [
      "dist/**",
      "!**/.vscode/*",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*, .npmrc, pnpm-lock.yaml}",
      "!{tsconfig.json, tsconfig.node.json, tsconfig.web.json}"
    ],
    "win": {
      "executableName": "client",
      "icon": "./src/assets/goob.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "mergeASARs": false,
      "category": "public.app-category.games",
      "icon": "./src/assets/goob.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "icon": "./src/assets/goob.png",
      "target": [
        {
          "target": "appImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "artifactName": "${name}.${ext}",
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "aegis-schema": "file:../schema",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.39.0",
    "protobufjs": "^8.8.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.3",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@swc/core": "^1.16.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "@swc/core@1.16.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
